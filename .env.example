# Database
DATABASE_URL="postgresql://acedesoft:acedesoft@localhost:5432/acedesoft_dev"

# API
API_PORT=3001

# Auth
JWT_ACCESS_SECRET="dev_access_secret_change_me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev_refresh_secret_change_me"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="dev_cookie_secret_change_me"
WEB_ORIGIN="http://localhost:3000"

# Rate limiting (global default; auth endpoints are stricter via @Throttle).
# THROTTLE_TTL is the window in ms, THROTTLE_LIMIT the max requests per window.
# Set THROTTLE_DISABLED=true to turn it off entirely (used by e2e tests).
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
THROTTLE_DISABLED="false"

# Stripe — pagos con tarjeta (Checkout). Usa claves de TEST hasta go-live.
# Secret key: Stripe Dashboard → Developers → API keys.
# Webhook secret (local): `stripe listen --forward-to localhost:3001/stripe/webhook`.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Seed (dev only — overrideable)
SEED_TENANT_SLUG="acme"
SEED_TENANT_NAME="Academia Acme"
SEED_ADMIN_EMAIL="admin@acme.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Web
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Email — Resend (recordatorios de impago). Sin clave, el envío se desactiva
# y la app sigue funcionando. API key: resend.com → API Keys.
# EMAIL_FROM debe usar un dominio verificado en Resend
# (sin dominio verificado: onboarding@resend.dev, solo envía a tu propio email).
RESEND_API_KEY=""
EMAIL_FROM="Tu Academia <no-reply@tudominio.com>"
