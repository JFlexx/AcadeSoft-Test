// AcadeSoft — MVP data model
// Multi-tenant SaaS for academy management.
// Row-level tenant isolation: every business entity carries tenantId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  PENDING
  WAITLIST // group was full; ordered by enrolledAt
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum TrialStatus {
  BOOKED    // reserved; attendance tells whether they came
  CONVERTED // enrolled afterwards
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceType {
  ORIGINAL
  RECTIFICATIVA
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
  DIRECT_DEBIT // domiciliación SEPA
}

enum RemittanceStatus {
  SENT      // XML generated and (presumably) uploaded to the bank
  COLLECTED // the bank paid it: payments registered
}

enum RemittanceItemStatus {
  SENT
  COLLECTED
  RETURNED // devuelto por el banco
}

// ─── Tenant ───────────────────────────────────────────────────────────────────

model Tenant {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  logoUrl        String?
  status         TenantStatus @default(ACTIVE)
  invoicePrefix    String       @default("F")
  invoiceCounter   Int          @default(0)
  lastInvoiceHash  String?
  legalName        String?
  taxId            String?
  address        String?
  contactEmail   String?
  contactPhone   String?
  iban           String?
  sepaCreditorId String?
  autoBillingEnabled Boolean  @default(false)
  autoBillingDay     Int      @default(1)
  remindersEnabled   Boolean  @default(false)
  // Email the family when a student is marked absent (opt-in).
  absenceNoticesEnabled Boolean @default(false)
  // Prospective families can book a free trial class online (opt-in).
  trialClassesEnabled Boolean @default(false)
  // First monthly fee of a mid-month enrollment covers only the classes left.
  prorateNewEnrollments Boolean @default(false)
  // IANA zone the academy's class times are written in (Canarias: Atlantic/Canary).
  timezone           String   @default("Europe/Madrid")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users     User[]
  students  Student[]
  teachers  Teacher[]
  courses   Course[]
  groups    Group[]
  sessions  Session[]
  invoices  Invoice[]
  payments  Payment[]
  auditLogs AuditLog[]
  messages  Message[]
  scheduleSlots ScheduleSlot[]
  holidays  Holiday[]
  trialClasses TrialClass[]
  sepaRemittances SepaRemittance[]
  assessments  Assessment[]
  rooms        Room[]

  @@map("tenants")
}

// ─── Role & User ──────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  users User[]

  @@map("roles")
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  roleId       String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(ACTIVE)
  refreshToken String?
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role          Role       @relation(fields: [roleId], references: [id])
  auditLogs     AuditLog[]
  guardianLinks Guardian[]
  teacherProfile Teacher?

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ─── Student & Guardian ───────────────────────────────────────────────────────

model Student {
  id        String    @id @default(cuid())
  tenantId  String
  firstName String
  lastName  String
  email     String?
  phone     String?
  birthDate DateTime?
  gender    Gender?
  address          String?
  photoUrl         String?
  notes            String?
  iban             String?
  mandateReference String?
  mandateDate      DateTime?
  discountPercent  Decimal?  @db.Decimal(5, 2)
  isActive         Boolean   @default(true)
  // GDPR erasure: everything but what the invoices legally need was removed.
  erasedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guardians   Guardian[]
  enrollments Enrollment[]
  attendances Attendance[]
  invoices    Invoice[]
  trialClasses TrialClass[]
  assessmentResults AssessmentResult[]

  @@index([tenantId])
  @@index([tenantId, lastName, firstName])
  @@map("students")
}

model Guardian {
  id           String   @id @default(cuid())
  studentId    String
  userId       String?
  firstName    String
  lastName     String
  relationship String
  email        String?
  phone        String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([userId])
  @@map("guardians")
}

// ─── Teacher ──────────────────────────────────────────────────────────────────

model Teacher {
  id        String   @id @default(cuid())
  tenantId  String
  firstName String
  lastName  String
  email     String?
  phone     String?
  bio       String?
  photoUrl  String?
  isActive  Boolean  @default(true)
  // Login of the teacher (role "teacher"), granted by an admin.
  userId    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  groups   Group[]
  sessions Session[]

  @@index([tenantId])
  @@map("teachers")
}

// ─── Course & Group ───────────────────────────────────────────────────────────

model Course {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  color       String?  @default("#6366f1")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groups Group[]

  @@index([tenantId])
  @@map("courses")
}

model Group {
  id          String    @id @default(cuid())
  tenantId    String
  courseId    String
  teacherId   String?
  name        String
  description String?
  schedule    Json?
  startDate   DateTime?
  endDate     DateTime?
  maxCapacity Int?
  // Usual classroom; a session can override it.
  roomId      String?
  monthlyFee  Decimal?  @db.Decimal(10, 2)
  // One-off fee charged when a student joins (matrícula).
  enrollmentFee Decimal? @db.Decimal(10, 2)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course      Course       @relation(fields: [courseId], references: [id])
  teacher     Teacher?     @relation(fields: [teacherId], references: [id])
  room        Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  sessions    Session[]
  scheduleSlots ScheduleSlot[]
  assessments   Assessment[]

  @@index([tenantId])
  @@index([courseId])
  @@map("groups")
}

// ─── Enrollment ───────────────────────────────────────────────────────────────

// A weekly class slot of a group ("lunes 17:00, 60 min"). Sessions are
// generated from these for a date range; see ScheduleService.
model ScheduleSlot {
  id              String   @id @default(cuid())
  tenantId        String
  groupId         String
  weekday         Int      // ISO: 1 = lunes … 7 = domingo
  startTime       String   // "HH:MM", hora local de la academia (Tenant.timezone)
  durationMinutes Int
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("schedule_slots")
}

// A day or period without classes (festivo, vacaciones), in academy-local
// calendar dates, both inclusive.
model Holiday {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cancelledSessions Session[]

  @@index([tenantId, startDate])
  @@map("holidays")
}

// A free trial class: a prospective student attends one real session of a
// group before enrolling. Booked from the public page or by the admin.
model TrialClass {
  id        String      @id @default(cuid())
  tenantId  String
  sessionId String
  studentId String
  status    TrialStatus @default(BOOKED)
  createdAt DateTime    @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([tenantId, createdAt])
  @@map("trial_classes")
}

// An evaluation of a group ("1ª evaluación", "Examen Unit 3") on a date.
model Assessment {
  id        String   @id @default(cuid())
  tenantId  String
  groupId   String
  name      String
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group   Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  results AssessmentResult[]

  @@index([groupId, date])
  @@map("assessments")
}

// A student's grade in an assessment: a 0–10 score and/or a comment.
model AssessmentResult {
  id           String   @id @default(cuid())
  assessmentId String
  studentId    String
  score        Decimal? @db.Decimal(4, 2)
  comment      String?
  updatedAt    DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@map("assessment_results")
}

// A classroom of the academy. Two classes in the same room at the same
// time are reported as a conflict (see RoomsService.conflicts).
model Room {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  capacity  Int?
  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groups   Group[]
  sessions Session[]

  @@unique([tenantId, name])
  @@map("rooms")
}

model Enrollment {
  id                 String           @id @default(cuid())
  studentId          String
  groupId            String
  status             EnrollmentStatus @default(ACTIVE)
  enrolledAt         DateTime         @default(now())
  droppedAt          DateTime?
  notes              String?
  monthlyFeeOverride Decimal?         @db.Decimal(10, 2)
  // Waiting list: when the family was emailed that a spot is free.
  spotOfferedAt      DateTime?

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@unique([studentId, groupId])
  @@index([groupId])
  @@map("enrollments")
}

// ─── Session & Attendance ─────────────────────────────────────────────────────

model Session {
  id          String        @id @default(cuid())
  tenantId    String
  groupId     String
  teacherId   String?
  scheduledAt DateTime
  startedAt   DateTime?
  endedAt     DateTime?
  status      SessionStatus @default(SCHEDULED)
  // null = 60 minutes (sessions created before durations existed)
  durationMinutes Int?
  // Set when a holiday cancelled this class, so removing the holiday can
  // put it back on the calendar.
  cancelledByHolidayId String?
  // Overrides the group's room for this class only.
  roomId      String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher     Teacher?     @relation(fields: [teacherId], references: [id])
  cancelledByHoliday Holiday? @relation(fields: [cancelledByHolidayId], references: [id], onDelete: SetNull)
  room        Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  attendances Attendance[]
  trialClasses TrialClass[]

  @@index([tenantId, scheduledAt])
  @@index([groupId])
  @@map("sessions")
}

model Attendance {
  id        String           @id @default(cuid())
  sessionId String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  notes     String?
  markedAt  DateTime         @default(now())
  // When the family was emailed about this absence (at most once).
  absenceNotifiedAt DateTime?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("attendances")
}

// ─── Invoice & Payment ────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  studentId     String
  enrollmentId  String?
  billingPeriod String?
  number        String
  description   String?
  notes         String?
  amount        Decimal       @db.Decimal(10, 2)
  paidAmount    Decimal       @db.Decimal(10, 2) @default(0)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  status        InvoiceStatus @default(PENDING)
  type          InvoiceType   @default(ORIGINAL)
  rectifiesId   String?
  hash          String?
  previousHash  String?
  hashedAt      DateTime?
  lastReminderAt DateTime?
  reminderCount  Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // NoAction: a student with invoices can't be deleted — invoices must be
  // kept (tax law) and the Verifactu chain can't lose links.
  student     Student     @relation(fields: [studentId], references: [id], onDelete: NoAction)
  enrollment  Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  payments    Payment[]
  remittanceItems SepaRemittanceItem[]
  rectifies   Invoice?    @relation("InvoiceRectification", fields: [rectifiesId], references: [id], onDelete: SetNull)
  rectifiedBy Invoice[]   @relation("InvoiceRectification")

  @@unique([tenantId, number])
  @@unique([enrollmentId, billingPeriod])
  @@index([tenantId, status])
  @@index([tenantId, issueDate])
  @@index([studentId])
  @@index([rectifiesId])
  @@map("invoices")
}

model Payment {
  id        String        @id @default(cuid())
  tenantId  String
  invoiceId String
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod @default(CASH)
  paidAt    DateTime      @default(now())
  reference String?
  notes     String?
  createdAt DateTime      @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  remittanceItems SepaRemittanceItem[]

  @@index([tenantId])
  @@index([invoiceId])
  @@map("payments")
}

// A SEPA direct-debit file sent to the bank. Recorded when the XML is
// downloaded, so an invoice can't be collected twice and its outcome
// (collected / returned) can be tracked per receipt.
model SepaRemittance {
  id             String           @id @default(cuid())
  tenantId       String
  messageId      String           @unique
  period         String           // "YYYY-MM" the invoices were selected from
  collectionDate DateTime         @db.Date
  total          Decimal          @db.Decimal(10, 2)
  itemCount      Int
  status         RemittanceStatus @default(SENT)
  collectedAt    DateTime?
  xml            String           // as sent, to download it again
  createdAt      DateTime         @default(now())

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  SepaRemittanceItem[]

  @@index([tenantId, createdAt])
  @@map("sepa_remittances")
}

model SepaRemittanceItem {
  id           String               @id @default(cuid())
  remittanceId String
  invoiceId    String
  amount       Decimal              @db.Decimal(10, 2)
  status       RemittanceItemStatus @default(SENT)
  paymentId    String?              // registered when the remittance is collected
  returnReason String?
  returnedAt   DateTime?
  createdAt    DateTime             @default(now())

  remittance SepaRemittance @relation(fields: [remittanceId], references: [id], onDelete: Cascade)
  invoice    Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment    Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([remittanceId])
  @@index([invoiceId])
  @@map("sepa_remittance_items")
}

// ─── AuditLog ─────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  entityType String
  entityId   String
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ─── Messaging ────────────────────────────────────────────────────────────────

enum MessageTarget {
  GROUP
  STUDENT
}

/// Email sent by an academy to a group or a student's family. History only:
/// no FK to group/student so deleting them keeps the record (targetLabel).
model Message {
  id             String        @id @default(cuid())
  tenantId       String
  subject        String
  body           String
  targetType     MessageTarget
  targetId       String
  targetLabel    String
  recipientCount Int           @default(0)
  sentCount      Int           @default(0)
  failedCount    Int           @default(0)
  createdById    String?
  createdAt      DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("messages")
}
