# Test database — separada de la de dev. Crear una vez con:
#   docker exec acedesoft_postgres createdb -U acedesoft acedesoft_test
# Aplicar migraciones (se reaplican idempotentemente en cada cambio de schema):
#   pnpm --filter api test:db:migrate
DATABASE_URL="postgresql://acedesoft:acedesoft@localhost:5432/acedesoft_test"

API_PORT=3001
JWT_ACCESS_SECRET="test_access_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="test_refresh_secret"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="test_cookie_secret"
WEB_ORIGIN="http://localhost:3000"

# Rate limiting disabled in tests (suites hammer /auth/login repeatedly).
THROTTLE_DISABLED="true"

# Stripe (pagos con tarjeta). Modo test hasta go-live.
STRIPE_SECRET_KEY="sk_test_dummy"
STRIPE_WEBHOOK_SECRET="whsec_dummy"
